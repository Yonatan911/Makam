<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <system.webServer>
    <handlers>
      <remove name="WebDAV" />
      <add name="MakamSession" path="api/auth/session.js" verb="*" modules="iisnode" />
      <add name="MakamIISNode" path="src/server.js" verb="*" modules="iisnode" />
    </handlers>
    <modules><remove name="WebDAVModule" /></modules>
    <!-- Inherit the approved absolute nodeProcessCommandLine from server/application configuration. -->
    <iisnode node_env="production" nodeProcessCountPerApplication="1"
             promoteServerVars="AUTH_USER,AUTH_TYPE" debuggingEnabled="false"
             debugHeaderEnabled="false" devErrorsEnabled="false" loggingEnabled="true"
             logDirectory="iisnode" gracefulShutdownTimeout="60000" />
    <rewrite>
      <rules>
        <!-- BEFORE rewriting/native promotion. Client identity and original-URL headers are forbidden. -->
        <rule name="RejectClientIdentityHeaders" stopProcessing="true">
          <match url=".*" />
          <conditions><add input="{ALL_RAW}" pattern="(?im)^\s*(x-iisnode-[^:]*|x-remote-user|x-user-id|x-readiness-proxy|x-original-url)\s*:" /></conditions>
          <action type="CustomResponse" statusCode="403" statusReason="Forbidden" statusDescription="Untrusted transport header" />
        </rule>
        <rule name="AnonymousPreflight" stopProcessing="true">
          <match url="^api(/.*)?$" />
          <conditions><add input="{REQUEST_METHOD}" pattern="^OPTIONS$" /></conditions>
          <action type="Rewrite" url="src/server.js" />
        </rule>
        <!-- Keep Windows auth on the physical rewritten endpoint; no farm-wide auth changes. -->
        <rule name="WindowsSessionExchange" stopProcessing="true">
          <match url="^api/auth/session$" />
          <action type="Rewrite" url="api/auth/session.js" />
        </rule>
        <rule name="DenyServerFiles" stopProcessing="true">
          <match url="^(src|shared|scripts|legacy|node_modules|iisnode|logs?|backups?|\.git|\.env[^/]*|package[^/]*|web\.config)(/.*)?$" ignoreCase="true" />
          <action type="CustomResponse" statusCode="404" statusReason="Not Found" statusDescription="Not Found" />
        </rule>
        <!-- NO IsFile bypass: backend is API-only; every other physical file is denied. -->
        <rule name="MakamAPI" stopProcessing="true">
          <match url="^api(/.*)?$" />
          <action type="Rewrite" url="src/server.js" />
        </rule>
        <rule name="DenyOtherPaths" stopProcessing="true">
          <match url=".*" />
          <action type="CustomResponse" statusCode="404" statusReason="Not Found" statusDescription="Not Found" />
        </rule>
      </rules>
    </rewrite>
    <httpErrors existingResponse="PassThrough" />
    <directoryBrowse enabled="false" />
    <security>
      <authentication><anonymousAuthentication enabled="true" /><windowsAuthentication enabled="false" /></authentication>
      <requestFiltering>
        <requestLimits maxAllowedContentLength="11534336" />
        <hiddenSegments>
          <add segment="node_modules" /><add segment="iisnode" /><add segment=".env" />
          <add segment=".git" /><add segment="logs" /><add segment="backups" />
          <add segment="legacy" /><add segment="scripts" /><add segment="shared" />
        </hiddenSegments>
      </requestFiltering>
    </security>
  </system.webServer>
  <location path="api/auth/session.js">
    <system.webServer><security><authentication><anonymousAuthentication enabled="false" /><windowsAuthentication enabled="true" /></authentication></security></system.webServer>
  </location>
</configuration>
