NODE_ENV=production
AUTH_MODE=iis-session
# Keep false until the approved IIS/Windows trust-boundary tests pass in staging.
TRUSTED_IDENTITY_VERIFIED=false
AD_DOMAIN=ARMY
MONGODB_URI=mongodb://REPLACE_WITH_ORGANIZATIONAL_MONGO:27017/?authSource=admin
MONGODB_DATABASE=makam
PUBLIC_API_URL=https://REPLACE_WITH_API_HOST/makam/api
APP_PUBLIC_URL=https://REPLACE_WITH_SP_HOST/sites/ops/Pages/Makam.aspx
SHAREPOINT_ORIGIN=https://REPLACE_WITH_SP_HOST
BOOTSTRAP_OWNER_SAM=m9267680
BOOTSTRAP_ADMIN_SAM=c9812933
JOBS_ENABLED=false
# Optional approved integrations. No external service is required.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_FROM=
SMTP_USER=
SMTP_PASSWORD=
LDAP_URL=
LDAP_BASE_DN=
LDAP_BIND_DN=
LDAP_BIND_PASSWORD=
# Never set PORT here in production; IISNode injects the named pipe.
